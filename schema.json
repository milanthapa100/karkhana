{
  "categories": {
    "update": {
      "directory": "content/updates",
      "allowedStatuses": ["draft", "in-progress", "done", "published"],
      "requiredSections": ["Description", "Progress", "Next Steps"]
    },
    "sop": {
      "directory": "content/sops",
      "allowedStatuses": ["draft", "active", "review", "archived"],
      "requiredSections": ["Description", "Steps", "Related"],
      "requiredFields": ["summary", "owner"]
    }
  },
  "dateFormat": "YYYY-MM-DD",
  "filenamePattern": "^[a-z0-9]+(-[a-z0-9]+)*\\.md$"
}
